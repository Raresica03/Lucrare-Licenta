      "get": {
        "tags": [
          "Admin"
        ],
        "description": "Fetch all users pending approval",
        "operationId": "GetPendingUsers",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/admin/approve-user/{userId}": {
      "post": {
        "tags": [
          "Admin"
        ],
        "description": "Approve a pending user",
        "operationId": "ApproveUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
